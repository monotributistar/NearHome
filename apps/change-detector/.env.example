# Change Detector — Environment Variables
# Copy to .env and adjust for your setup

# ── RTSP Source ──
CHANGE_RTSP_URL=rtsp://localhost:8554/alpha-entrada
CHANGE_TENANT_ID=poc-tenant
CHANGE_CAMERA_ID=poc-camera

# ── Inference Bridge ──
CHANGE_INFERENCE_URL=http://localhost:8090/v1/infer/hf/yolo

# ── Detection Tuning ──
CHANGE_MOTION_THRESHOLD=0.05
CHANGE_FRAME_SKIP=3
CHANGE_FRAME_WIDTH=640
CHANGE_FRAME_HEIGHT=480
CHANGE_MOTION_COOLDOWN_S=1.0

# ── Service ──
CHANGE_PORT=8085
