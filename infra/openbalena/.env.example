# openbalena Environment Configuration
# Copy this file to .env and configure for your environment

# Database
DB_PASSWORD=openbalena_change_me

# openbalena Version (use specific version for production stability)
OPENBALENA_VERSION=v0.2.0

# API Configuration
API_HOST=api.balena
VPN_HOST=vpn.balena

# JWT Secret (generate a strong random string for production)
JWT_SECRET=change_me_generate_random_string_here

# VPN Configuration
VPN_API_KEY=change_me_vpn_shared_secret

# S3 Storage (MinIO configuration)
S3_ACCESS_KEY=openbalena
S3_SECRET_KEY=openbalena_change_me
S3_BUCKET=openbalena
S3_REGION=us-east-1

# Registry Authentication
REGISTRY_USER=admin
REGISTRY_PASSWORD=admin_change_me

# Optional: Mixpanel analytics
# MIXPANEL_TOKEN=your_mixpanel_token_here

# Device Configuration
DEVICE_CONFIG_ENDPOINT=https://api.balena