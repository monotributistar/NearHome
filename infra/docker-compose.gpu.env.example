# ─────────────────────────────────────────────────────────────────────────────
# NearHome GPU Node — Environment
# Copiar a .env y completar las IPs de Tailscale
# ─────────────────────────────────────────────────────────────────────────────

# IP de Tailscale de la Linux box (ej: 100.x.x.x)
GPU_NODE_TAILSCALE_IP=100.xx.xx.xx

# IP de Tailscale del macOS (ej: 100.y.y.y)
MAC_TAILSCALE_IP=100.yy.yy.yy

# Token de enrollment (opcional, genera uno automático si está vacío)
NODE_ENROLLMENT_TOKEN=

# Admin secret para auth (debe coincidir con docker-compose.poc.yml)
NODE_AUTH_ADMIN_SECRET=replace-with-a-random-secret
